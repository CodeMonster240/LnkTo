<%- include('partials/_header', { title: 'Shorten', active: 'home' }) %>

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__inner">
    <h1 class="hero__title" id="hero-title">
      Paste a long link. <span class="hero__accent">Get a short one.</span>
    </h1>
    <p class="hero__sub">
      LnkTo turns any URL into a three-character code. No sign-up, no tracking
      pixels, no email. Each link keeps a private analytics trail for you.
    </p>

        <form
      action="<%= urlFor('index') %>"
      class="shorten"
      method="post"
      autocomplete="off"
      novalidate
      id="shorten-form"
    >
      <label class="shorten__label" for="url-input">Long URL</label>
      <div class="shorten__row">
        <input
          id="url-input"
          type="url"
          name="old"
          class="shorten__input"
          placeholder="https://example.com/very/long/path"
          autocomplete="off"
          spellcheck="false"
          required
          aria-describedby="shorten-help"
        />
        <button type="submit" class="shorten__btn" aria-label="Shorten URL">
          <span class="shorten__btn-label">Shorten</span>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14" /><path d="m13 5 7 7-7 7" />
          </svg>
        </button>
      </div>
      <p class="shorten__help" id="shorten-help">
        Links are stored locally. Plain <code>https://</code> or
        <code>example.com</code> formats both work.
      </p>

      <% if (form.errors && form.errors._form) { %>
        <p class="form-error" role="alert"><%= form.errors._form %></p>
      <% } %>
      <% if (form.errors && form.errors.old) { %>
        <p class="form-error" role="alert"><%= form.errors.old %></p>
      <% } %>
      <% if (form.errors && form.errors.custom_code) { %>
        <p class="form-error" role="alert"><%= form.errors.custom_code %></p>
      <% } %>

      <!-- Hidden fields populated by the custom-link popup -->
      <input type="hidden" name="custom_code" id="custom-code-field" value="" />
      <input type="hidden" name="code_length" id="code-length-field" value="3" />
      <input type="hidden" name="show_redirect_page" id="show-redirect-field" value="0" />
      <input type="hidden" name="redirect_duration" id="redirect-duration-field" value="3" />
      <input type="hidden" name="show_thumbnail" id="show-thumbnail-field" value="0" />

      <!-- Honeypot: hidden from humans via CSS/aria, but visible to
           dumb bots that auto-fill every field. Must stay empty. -->
      <div class="honeypot" aria-hidden="true">
        <label for="website_url">Website (leave blank)</label>
        <input
          type="text"
          id="website_url"
          name="website_url"
          tabindex="-1"
          autocomplete="off"
          value=""
        />
      </div>
      <input type="hidden" name="renderedAt" value="<%= renderedAt %>" />
        </form>
  </div>
</section>

<!-- Custom Link Popup / Modal -->
<div class="popup" id="custom-popup" role="dialog" aria-labelledby="popup-title" aria-hidden="true" tabindex="-1">
  <div class="popup__backdrop" data-action="close-popup"></div>
  <div class="popup__panel">
    <button type="button" class="popup__close" data-action="close-popup" aria-label="Close">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <h2 class="popup__title" id="popup-title">Your link is ready to shorten</h2>
    <p class="popup__sub">Pick a custom short code, or let us generate one.</p>

    <div class="popup__body">
      <!-- Custom slug field with live availability check -->
      <div class="field">
        <label class="field__label" for="custom-slug">Custom short link (optional)</label>
        <div class="slug-check">
          <span class="slug-check__prefix" aria-hidden="true">/</span>
          <input
            type="text"
            id="custom-slug"
            name="custom_code"
            class="slug-check__input"
            maxlength="50"
            placeholder="Enter custom text…"
            autocomplete="off"
          />
          <span class="slug-check__status" id="slug-status" aria-live="polite">
            <span class="slug-check__default">Default: 3 random chars</span>
          </span>
        </div>
      </div>

      <!-- Character length slider (3–50) -->
      <div class="field" id="length-slider-field">
        <label class="field__label" for="code-length">
          <span>Short code length</span>
          <span class="field__desc">
            Longer codes are harder to guess but give more unique combinations.
          </span>
        </label>
        <div class="slider-row">
          <span class="slider-row__min" aria-label="Minimum length">3</span>
          <input
            type="range"
            id="code-length"
            name="code_length"
            min="3"
            max="50"
            value="3"
            class="slider"
            aria-valuemin="3"
            aria-valuemax="50"
            aria-valuenow="3"
          />
          <span class="slider-row__max" aria-label="Maximum length">50</span>
          <output class="slider-row__val" id="length-output" for="code-length">3</output>
        </div>
      </div>

      <!-- Settings: Show Redirect Page -->
      <div class="field">
        <label class="field__label" for="popup-show-redirect">
          <span>Show Redirect Page</span>
          <span class="field__desc">
            Show an animated interstitial before redirecting visitors.
          </span>
        </label>
        <div class="toggle">
          <input type="checkbox" id="popup-show-redirect" value="1" />
          <label class="toggle__track" for="popup-show-redirect"></label>
        </div>
      </div>

      <!-- Settings: Redirect Duration (shown when redirect page enabled) -->
      <div class="field" id="popup-duration-field" style="display:none;">
        <label class="field__label" for="popup-redirect-duration">
          <span>Redirect Duration</span>
          <span class="field__desc">How long the interstitial shows (1–30 seconds).</span>
        </label>
        <div class="field__control">
          <input
            type="number"
            id="popup-redirect-duration"
            min="1"
            max="30"
            value="3"
            class="field__input"
          />
          <span class="field__unit">seconds</span>
        </div>
      </div>

      <!-- Settings: Show Thumbnail -->
      <div class="field">
        <label class="field__label" for="popup-show-thumbnail">
          <span>Show Thumbnail</span>
          <span class="field__desc">
            Display the destination site's thumbnail in the wormhole animation.
          </span>
        </label>
        <div class="toggle">
          <input type="checkbox" id="popup-show-thumbnail" value="1" />
          <label class="toggle__track" for="popup-show-thumbnail"></label>
        </div>
      </div>
    </div>

    <div class="popup__actions">
      <button type="button" class="btn btn--ink" id="popup-confirm" data-action="confirm-shorten">
        Create short link
      </button>
      <button type="button" class="btn btn--ghost" data-action="close-popup">
        Cancel
      </button>
    </div>
  </div>
</div>

<section class="features" aria-label="What you get">
  <article class="feature">
    <div class="feature__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.5 1.5" />
        <path d="M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.5-1.5" />
      </svg>
    </div>
    <h2 class="feature__title">Three characters. Done.</h2>
    <p class="feature__body">Each short link is a 3-letter code you can read aloud and type without looking.</p>
  </article>
  <article class="feature">
    <div class="feature__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 3v18h18" /><path d="M7 14l4-4 4 4 5-5" />
      </svg>
    </div>
    <h2 class="feature__title">A trail of every click</h2>
    <p class="feature__body">Open a link's analytics to see daily hits, top referrers, and the devices that followed the trail.</p>
  </article>
  <article class="feature">
    <div class="feature__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 6h18" /><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
      </svg>
    </div>
    <h2 class="feature__title">Yours to delete</h2>
    <p class="feature__body">Hit delete on any link and it's gone. Its analytics go with it. The short code is free for re-use.</p>
  </article>
</section>

<%- include('partials/_footer', { pageScript: 'home.js' }) %>
