# LnkTo (Node.js) environment configuration.
#
# All variables are read by config.js via dotenv.
#
# SETUP:
#   1. Copy this file to ".env" (same folder):
#        cp .env.example .env
#   2. Fill in the values. Never commit .env to git (.gitignore already
#      excludes it).
#   3. SECRET_KEY is reserved (kept for future-proofing). The current
#      bot check is a honeypot + time threshold and does not need it.

# Reserved — currently unused. Set to a long random string in production
# so that if/when it's used for cookie signing, you don't ship the
# dev fallback. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRET_KEY=replace-me-with-a-long-random-string

# 1 = verbose logging (do NOT use in production). 0 = off.
DEBUG=0

# "production" turns off the dev-only SERVER_NAME in config.js.
LNKTO_ENV=production

# Optional: full path to the SQLite database file.
# Defaults to /tmp/shortener.db on Vercel and
# <HOME>/LnkTo_data/shortener.db elsewhere.
# LNKTO_DATABASE_URL=sqlite:////home/<you>/LnkTo_data/shortener.db

# Optional: directory holding the SQLite file (defaults to ~/LnkTo_data).
# LNKTO_DB_DIR=/home/<you>/LnkTo_data

# Optional: server bind address / port (defaults to 0.0.0.0:5001).
# HOST=0.0.0.0
# PORT=5001

# Note: We deliberately don't read DATABASE_URL. Use the explicit
# LNKTO_DATABASE_URL variable so the database driver is unambiguous.