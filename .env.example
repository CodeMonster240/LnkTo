# LnkTo environment configuration.
#
# On PythonAnywhere (free tier included), the "Environment variables"
# box on the Web tab does NOT accept custom keys like SECRET_KEY —
# it is restricted to HTTP_* on free accounts.
#
# The recommended workflow is to set them in this file and let wsgi.py
# load it via python-dotenv.
#
# SETUP:
#   1. Copy this file to ".env" (same folder):
#        cp .env.example .env
#   2. Fill in the values. Never commit .env to git (.gitignore already
#      excludes it).
#   3. Generate a SECRET_KEY with:
#        python -c "import secrets; print(secrets.token_urlsafe(48))"

# Required: a long random string. NEVER use the default in production.
SECRET_KEY=replace-me-with-a-long-random-string

# 1 = Flask debug mode (do NOT use in production). 0 = off.
DEBUG=0

# "production" turns off the dev-only SERVER_NAME in settings.py.
FLASK_ENV=production

# Optional: full path to the SQLite database file.
# Defaults to <HOME>/LnkTo_data/shortener.db on PythonAnywhere,
# next to the project otherwise.
# DATABASE_URL=sqlite:////home/<you>/LnkTo_data/shortener.db